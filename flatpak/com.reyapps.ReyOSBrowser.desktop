[Desktop Entry]
Version=1.0
Type=Application
Name=ReyOS Browser
Comment=Private browsing and tracking protection by default
Exec=com.reyapps.ReyOSBrowser %U
Icon=com.reyapps.ReyOSBrowser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=com.reyapps.ReyOSBrowser
Keywords=browser;web;private;privacy;
