<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.reyapps.Reyva</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Reyva</name>
  <summary>Private-by-default web browser</summary>

  <developer id="com.reyapps">
    <name>ReyApps</name>
  </developer>

  <launchable type="desktop-id">com.reyapps.Reyva.desktop</launchable>

  <description>
    <p>
      Reyva is a lightweight Chromium-based browser that keeps nothing by
      default. Tabs, history, cookies and site data live in memory and are
      gone when you close it. No account, no sync, no telemetry.
    </p>
    <ul>
      <li>Shields: built-in tracker and ad blocking, with per-site exceptions</li>
      <li>HTTPS upgrade, tracking-parameter stripping and fingerprinting protection</li>
      <li>Optional saved passwords, stored in your system keyring</li>
      <li>Bookmarks with folders, and import from other browsers</li>
      <li>Reader mode, find in page and a download manager</li>
      <li>Low Memory Mode, which suspends background tabs you are not using</li>
    </ul>
  </description>

  <url type="homepage">https://reyos.reyapps.com</url>
  <url type="bugtracker">https://github.com/Reypaulino/ReyOS/issues</url>
  <url type="vcs-browser">https://github.com/Reypaulino/ReyOS</url>

  <branding>
    <color type="primary" scheme_preference="light">#E8C9A8</color>
    <color type="primary" scheme_preference="dark">#5A3A1E</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>New tab page</caption>
      <image>https://raw.githubusercontent.com/Reypaulino/ReyOS/main/flatpak/screenshots/new-tab.png</image>
    </screenshot>
    <screenshot>
      <caption>Browsing with Shields on</caption>
      <image>https://raw.githubusercontent.com/Reypaulino/ReyOS/main/flatpak/screenshots/browsing.png</image>
    </screenshot>
  </screenshots>

  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>

  <provides>
    <binary>com.reyapps.Reyva</binary>
  </provides>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <releases>
    <release version="0.1.0" date="2026-10-05">
      <description>
        <p>First Flathub release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>
</component>
