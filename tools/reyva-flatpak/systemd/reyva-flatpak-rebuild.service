[Unit]
Description=Rebuild the Reyva Flatpak when Flathub updates its KDE runtime or PySide BaseApp
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=%h/.local/libexec/reyos/reyva-flatpak-rebuild.sh
TimeoutStartSec=2h
