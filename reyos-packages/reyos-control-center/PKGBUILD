# Maintainer: Rey Paulino
pkgname=reyos-control-center
pkgver=1.0.0
pkgrel=16
pkgdesc="ReyOS System Tools — terminal quick-launcher for system care, updates, network, and disk utilities"
arch=('any')
license=('MIT')
depends=('htop' 'flatpak' 'openssh' 'rsync' 'neofetch' 'libnotify' 'pacman-contrib' 'ufw')
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/files/usr/share/reyos/bin/reyos-system-menu.sh" \
        "$pkgdir/usr/share/reyos/bin/reyos-system-menu.sh"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/share/reyos/bin/reyos-system-menu.sh "$pkgdir/usr/bin/reyos-tools"
    install -Dm755 "$startdir/files/usr/share/reyos/bin/reyos-update-notify.sh" \
        "$pkgdir/usr/share/reyos/bin/reyos-update-notify.sh"
    install -Dm755 "$startdir/files/usr/share/reyos/bin/reyos-apply-skel-bashrc.sh" \
        "$pkgdir/usr/share/reyos/bin/reyos-apply-skel-bashrc.sh"
    install -Dm644 "$startdir/files/etc/reyos/skel.bashrc" \
        "$pkgdir/etc/reyos/skel.bashrc"
    install -Dm644 "$startdir/files/usr/share/libalpm/hooks/reyos-control-center-bashrc.hook" \
        "$pkgdir/usr/share/libalpm/hooks/reyos-control-center-bashrc.hook"
    install -Dm644 "$startdir/files/etc/skel/.config/autostart/reyos-update-notify-autostart.desktop" \
        "$pkgdir/etc/skel/.config/autostart/reyos-update-notify-autostart.desktop"
    install -Dm644 "$startdir/files/etc/skel/.config/autostart/org.kde.discover.notifier.desktop" \
        "$pkgdir/etc/skel/.config/autostart/org.kde.discover.notifier.desktop"
}
