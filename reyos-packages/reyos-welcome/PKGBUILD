# Maintainer: Rey Paulino
pkgname=reyos-welcome
pkgver=3.3.3
pkgrel=17
pkgdesc="ReyOS Welcome first-login setup wizard (Kirigami/QML) — post-install software picker"
arch=('any')
license=('MIT')
depends=('pyside6' 'kirigami' 'discover' 'reyos-control-center-gui')
source=()
sha256sums=()

package() {
    cp -a "$startdir/files/etc" "$pkgdir/"
    cp -a "$startdir/files/usr" "$pkgdir/"
    find "$pkgdir/etc/skel/.local/share/applications" -type f -exec chmod 644 {} \;
    find "$pkgdir/etc/skel/.config/autostart" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr/share/reyos/welcome/qml" -type f -exec chmod 644 {} \;
    chmod 755 "$pkgdir/usr/share/reyos/welcome/main.py"
}
