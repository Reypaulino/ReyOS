#!/bin/sh
# PCSX2's menu entry (ReyOS's copy in ~/.local/share/applications, written by
# emulation.sync_pcsx2_launcher): give PCSX2 ReyOS's BIOS and game folders,
# Display settings, controller mapping and (on a laptop) the NVIDIA card first,
# as a launch from Control Center does.
ARGS=$(/usr/bin/python3 -I -c '
import sys
sys.path.insert(0, "/usr/share/reyos/control-center")
import emulation
emulation.prepare_flatpak(next(s for s in emulation.EMU_SYSTEMS if s["id"] == "ps2"))
print(" ".join(emulation.pcsx2_run_args()))
') || ARGS=
# shellcheck disable=SC2086  # --env=NAME=VALUE options, no spaces
exec flatpak run $ARGS net.pcsx2.PCSX2 "$@"
