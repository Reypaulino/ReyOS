# Maintainer: Rey Paulino
pkgname=reyos-control-center-gui
pkgver=1.0.0
pkgrel=38
pkgdesc="ReyOS Control Center — Kirigami/QML GUI for updates, performance, network, disk and permissions"
arch=('any')
license=('MIT')
depends=('reyos-control-center' 'pyside6' 'kirigami' 'flatpak' 'kdialog' 'polkit' 'pciutils' 'ufw' 'bluez-utils' 'pipewire-pulse'
         'xorg-xinput' 'xorg-setxkbmap' 'xbindkeys' 'timeshift' 'wireguard-tools')
source=()
sha256sums=()

package() {
    cp -a "$startdir/files/etc" "$pkgdir/"
    cp -a "$startdir/files/usr" "$pkgdir/"
    find "$pkgdir/etc/skel/.local/share/applications" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr/share/reyos/control-center/qml" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr/local/share/applications" -type f -exec chmod 644 {} \;
    chmod 644 "$pkgdir/usr/share/polkit-1/actions/org.reyos.controlcenter.policy"
    chmod 755 "$pkgdir/usr/share/reyos/control-center/main.py"
    chmod 755 "$pkgdir/usr/share/reyos/control-center/reyos-fix-permissions.sh"
    chmod 755 "$pkgdir/usr/share/reyos/control-center/reyos-manage-users.sh"
}
