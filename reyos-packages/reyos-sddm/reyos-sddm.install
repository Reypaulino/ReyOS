post_install() {
    chmod 755 /usr/share/sddm/themes/reyos
    /usr/share/reyos/bin/reyos-brand-sddm-sessions
    /usr/share/reyos/bin/reyos-render-sddm-look
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f \
        /usr/local/share/wayland-sessions/plasma.desktop \
        /usr/local/share/xsessions/plasmax11.desktop
    rmdir --ignore-fail-on-non-empty \
        /usr/local/share/wayland-sessions \
        /usr/local/share/xsessions \
        2>/dev/null || true
}
