; ReyOS preset for SilentSDDM (https://github.com/uiriansan/SilentSDDM).
; reyos.conf is rendered from reyos.conf.in by Control Center (looks.py)
; on every Look switch and at login: each #C97932 becomes the Look's accent
; and both background lines point at the Look's wallpaper. Edit the .in
; template, not reyos.conf. As shipped, reyos.conf is the Copper rendering.

[General]
scale = 1.0
enable-animations = true
animated-background-placeholder = ""
background-fill-mode = "fill"

[LockScreen]
display = true
padding-top = 0
padding-right = 0
padding-bottom = 0
padding-left = 0
background = "reyos.jpg"
use-background-color = false
background-color = "#14100d"
blur = 28
brightness = -0.15
saturation = 0.0
input-keystroke = false
ignore-shift-key = false

[LockScreen.Clock]
display = true
position = "top-center"
align = "center"
format = "hh:mm"
font-family = "RedHatDisplay"
font-size = 86
font-weight = 800
color = "#FFFFFF"

[LockScreen.Date]
display = true
format = "dddd, MMMM d"
locale = "en_US"
font-family = "RedHatDisplay"
font-size = 16
font-weight = 500
color = "#FFFFFF"
margin-top = -10

[LockScreen.Message]
display = true
position = "bottom-center"
align = "center"
text = "Press any key"
font-family = "RedHatDisplay"
font-size = 12
font-weight = 400
display-icon = true
icon = "enter.svg"
icon-size = 16
color = "#FFFFFF"
paint-icon = true
spacing = 6

[LoginScreen]
background = "reyos.jpg"
use-background-color = false
background-color = "#14100d"
blur = 28
brightness = -0.2
saturation = 0.0

[LoginScreen.LoginArea]
position = "center"
margin = -1

[LoginScreen.LoginArea.Avatar]
shape = "circle"
border-radius = 35
active-size = 110
inactive-size = 78
inactive-opacity = 0.4
active-border-size = 3
inactive-border-size = 0
active-border-color = "#C97932"
inactive-border-color = "#FFFFFF"
always-active = false

[LoginScreen.LoginArea.Username]
font-family = "RedHatDisplay"
font-size = 18
font-weight = 700
color = "#FFFFFF"
margin = 12

[LoginScreen.LoginArea.PasswordInput]
width = 220
height = 36
display-icon = true
font-family = "RedHatDisplay"
font-size = 13
icon = "password.svg"
icon-size = 16
content-color = "#FFFFFF"
background-color = "#FFFFFF"
background-opacity = 0.12
border-size = 0
border-color = "#FFFFFF"
border-radius-left = 12
border-radius-right = 12
margin-top = 14
masked-character = "●"

[LoginScreen.LoginArea.LoginButton]
background-color = "#C97932"
background-opacity = 1.0
active-background-color = "#C97932"
active-background-opacity = 0.8
icon = "arrow-right.svg"
icon-size = 18
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
border-size = 0
border-color = "#FFFFFF"
border-radius-left = 12
border-radius-right = 12
margin-left = 6
show-text-if-no-password = true
hide-if-not-needed = false
font-family = "RedHatDisplay"
font-size = 13
font-weight = 600

[LoginScreen.LoginArea.Spinner]
display-text = true
text = "Logging in"
font-family = "RedHatDisplay"
font-weight = 600
font-size = 14
icon-size = 28
icon = "spinner.svg"
color = "#C97932"
spacing = 6

[LoginScreen.LoginArea.WarningMessage]
font-family = "RedHatDisplay"
font-size = 12
font-weight = 400
normal-color = "#FFFFFF"
warning-color = "#F0A96A"
error-color = "#F06A72"
margin-top = 12

[LoginScreen.MenuArea.Buttons]
margin-top = 40
margin-right = 40
margin-bottom = 40
margin-left = 40
size = 32
border-radius = 8
spacing = 10
font-family = "RedHatDisplay"

[LoginScreen.MenuArea.Popups]
max-height = 300
item-height = 32
item-spacing = 2
padding = 6
display-scrollbar = true
margin = 6
background-color = "#14100d"
background-opacity = 0.9
active-option-background-color = "#C97932"
active-option-background-opacity = 0.3
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
font-family = "RedHatDisplay"
border-size = 1
border-color = "#C97932"
font-size = 12
icon-size = 16

[LoginScreen.MenuArea.Session]
display = true
position = "bottom-left"
index = 0
popup-direction = "up"
popup-align = "center"
display-session-name = true
button-width = 200
popup-width = 200
background-color = "#FFFFFF"
background-opacity = 0.0
active-background-opacity = 0.2
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
border-size = 0
font-size = 11
icon-size = 16

[LoginScreen.MenuArea.Layout]
display = true
position = "bottom-right"
index = 0
popup-direction = "up"
popup-align = "center"
popup-width = 180
display-layout-name = true
background-color = "#FFFFFF"
background-opacity = 0.0
active-background-opacity = 0.2
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
border-size = 0
font-size = 11
icon = "language.svg"
icon-size = 16

[LoginScreen.MenuArea.Keyboard]
display = true
position = "bottom-right"
index = 0
background-color = "#FFFFFF"
background-opacity = 0.0
active-background-opacity = 0.2
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
border-size = 0
icon = "keyboard.svg"
icon-size = 16

[LoginScreen.MenuArea.Power]
display = true
position = "bottom-right"
index = 0
popup-direction = "up"
popup-align = "center"
popup-width = 100
background-color = "#FFFFFF"
background-opacity = 0.0
active-background-opacity = 0.2
content-color = "#FFFFFF"
active-content-color = "#FFFFFF"
border-size = 0
icon = "power.svg"
icon-size = 16

[LoginScreen.VirtualKeyboard]
scale = 1.0
position = "login"
start-hidden = true
background-color = "#FFFFFF"
background-opacity = 0.15
key-content-color = "#FFFFFF"
key-color = "#FFFFFF"
key-opacity = 0.15
key-active-background-color = "#C97932"
key-active-opacity = 0.4
selection-background-color = "#C97932"
selection-content-color = "#FFFFFF"
primary-color = "#FFF"
border-size = 0
border-color = "#000000"
restrict-input = "none"

[Tooltips]
enable = true
font-family = "RedHatDisplay"
font-size = 11
content-color = "#FFFFFF"
background-color = "#14100d"
background-opacity = 0.85
border-radius = 6
disable-user = false
disable-login-button = false
