# Maintainer: Rey Paulino
pkgname=reyos-sddm
pkgver=1.0.3
pkgrel=11
pkgdesc="ReyOS login screen — dedicated branded theme (dark navy + copper accent, dedicated background)"
arch=('any')
license=('MIT')
# qt5-declarative isn't in sddm's hard Depends (only listed as an optional
# "for using Qt5 themes" dep) but the actual sddm-greeter binary shipped by
# this sddm build is linked against Qt5 (libQt5Quick/Qml/Network/Gui/Core),
# same as the maldives/elarun/maya themes it bundles -- without it the
# greeter fails to exec at all (dynamic linker can't resolve those libs)
# and sddm crash-loops with "exited with 127". Confirmed live on the dev
# VM 2026-08-11.
depends=('sddm' 'qt5-declarative')
source=()
sha256sums=()

package() {
    cp -a "$startdir/files/etc" "$pkgdir/"
    cp -a "$startdir/files/usr" "$pkgdir/"
    find "$pkgdir/etc" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr" -type f -exec chmod 644 {} \;
}
