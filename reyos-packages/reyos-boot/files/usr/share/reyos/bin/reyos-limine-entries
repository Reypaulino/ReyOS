#!/usr/bin/python3 -I
"""Keeps ReyOS's Limine boot menu in step with the installed kernels.

The installer writes one entry ("/+ReyOS" with the kernel inside it). This
replaces ReyOS's entries in limine.conf with one entry per bootable kernel
image, so an update that breaks the normal kernel still leaves a way in:

    /ReyOS                          linux (the default)
    /ReyOS (LTS kernel, backup)     linux-lts, from reyos-boot
    /ReyOS (fallback initramfs)     linux with every driver, if the image exists
    /ReyOS snapshot (before update, Oct 17 23:00)
                                    one per automatic btrfs snapshot that has
                                    a kernel copy in <ESP>/reyos-snapshots/
                                    (made by reyos-base's reyos-snapshots)

A flat list on purpose: with a "/+ReyOS" folder, Limine kept highlighting the
folder (the old entry's place, remembered by remember_last_entry), which can't
be booted, so the countdown never started and the machine sat at the menu.
`default_entry` is set to the plain "ReyOS" entry. Everything that isn't a
ReyOS entry (the header, other systems a user added) is kept as it is. Run by
a pacman hook after mkinitcpio, and by reyos-boot's install script.

Never makes a system unbootable on purpose: it only rewrites the file when
ReyOS's entries and their kernel command line are recognized and the normal
kernel's files exist, keeps limine.conf.reyos-bak, and replaces the file
atomically.
"""
import json
import os
import re
import sys
from pathlib import Path

DEFAULTS = Path("/etc/default/limine")
TOP_ENTRY = re.compile(r"^/(?!/)")          # a top-level entry or folder line
REYOS_TOP = re.compile(r"^/\+?ReyOS(\s*$| \(| snapshot \()")
ROOT_SUBVOL = re.compile(r"(rootflags=\S*?subvol=)[^,\s]+")
DEFAULT_ENTRY = re.compile(r"^default_entry:.*$")
KERNELS = [
    # (title, kernel, initramfs)
    ("ReyOS", "vmlinuz-linux", "initramfs-linux.img"),
    ("ReyOS (LTS kernel, backup)", "vmlinuz-linux-lts", "initramfs-linux-lts.img"),
    ("ReyOS (fallback initramfs)", "vmlinuz-linux", "initramfs-linux-fallback.img"),
]


def esp_path(root):
    try:
        m = re.search(r'^ESP_PATH="?([^"\n]+)"?', (root / DEFAULTS.relative_to("/")).read_text(), re.M)
        if m:
            return root / m.group(1).lstrip("/")
    except OSError:
        pass
    return root / "boot"


def find_section(lines):
    """(start, end) of ReyOS's entries, end exclusive: from the first ReyOS
    top-level line through every following ReyOS entry (and, for the
    installer's folder form, its "//" sub-entries)."""
    for i, line in enumerate(lines):
        if REYOS_TOP.match(line):
            end = len(lines)
            for j in range(i + 1, len(lines)):
                if TOP_ENTRY.match(lines[j]) and not REYOS_TOP.match(lines[j]):
                    end = j
                    break
            # Blank lines and unindented lines (e.g. a "comment:" written just
            # before the next system) at the end belong to what follows, not
            # to ReyOS; ReyOS's own option lines are indented, entries start "/".
            while end > i + 1 and (lines[end - 1].strip() == ""
                                   or not lines[end - 1].startswith(("\t", " ", "/"))):
                end -= 1
            return i, end
    return None


def snapshots(esp):
    """[(title, kernel, initramfs, subvol)] newest first, from the kernel
    copies reyos-snapshots keeps next to each automatic snapshot."""
    out = []
    base = esp / "reyos-snapshots"
    if not base.is_dir():
        return out
    for d in sorted(base.iterdir(), reverse=True):
        try:
            info = json.loads((d / "info.json").read_text())
        except (OSError, ValueError):
            continue
        if (d / "vmlinuz-linux").is_file() and (d / "initramfs-linux.img").is_file() \
                and re.fullmatch(r"/timeshift-btrfs/snapshots/[\w.-]+/@", info.get("subvol", "")):
            out.append((info.get("title") or f"ReyOS snapshot ({d.name})",
                        f"reyos-snapshots/{d.name}/vmlinuz-linux",
                        f"reyos-snapshots/{d.name}/initramfs-linux.img",
                        info["subvol"]))
    # Two snapshots in the same minute would get the same title, and Limine
    # remembers the last entry by title: add the seconds to tell them apart.
    titles = [t for t, *_ in out]
    for i, (title, *rest) in enumerate(out):
        if titles.count(title) > 1:
            m = re.search(r"snapshots/(\d{4}-\d\d-\d\d)_(\d\d)-(\d\d)-(\d\d)/", rest[2])
            if m:
                out[i] = (title.replace(f"{m.group(2)}:{m.group(3)})", f"{m.group(2)}:{m.group(3)}:{m.group(4)})"), *rest)
    return out


def entry(title, kernel, initrd, cmdline, kernel_key):
    return [f"/{title}",
            "\tprotocol: linux",
            f"\t{kernel_key}: boot():/{kernel}",
            f"\tmodule_path: boot():/{initrd}",
            f"\tcmdline: {cmdline}"]


def build(esp, cmdline, kernel_key):
    out = []
    for title, kernel, initrd in KERNELS:
        if (esp / kernel).is_file() and (esp / initrd).is_file():
            out += entry(title, kernel, initrd, cmdline, kernel_key)
    # Snapshot entries only on btrfs (the root subvolume is in the command
    # line); each boots its snapshot with the kernel it was taken with.
    if ROOT_SUBVOL.search(cmdline):
        for title, kernel, initrd, subvol in snapshots(esp):
            out += entry(title, kernel, initrd, ROOT_SUBVOL.sub(lambda m: m.group(1) + subvol, cmdline, count=1), kernel_key)
    return out


def set_default(lines, start):
    """Points default_entry at the plain ReyOS entry: Limine counts every
    entry line (folders and sub-entries too) from 1."""
    index = sum(1 for l in lines[:start] if l.startswith("/")) + 1
    wanted = f"default_entry: {index}"
    for i, line in enumerate(lines):
        if line.startswith("/"):
            break
        if DEFAULT_ENTRY.match(line):
            lines[i] = wanted
            return lines
    first = next((i for i, l in enumerate(lines) if l.startswith("/")), len(lines))
    insert_at = next((i + 1 for i, l in enumerate(lines[:first]) if l.startswith("timeout:")), 0)
    return lines[:insert_at] + [wanted] + lines[insert_at:]


def main(argv):
    root = Path(argv[argv.index("--root") + 1]) if "--root" in argv else Path("/")
    esp = esp_path(root)
    conf = esp / "limine.conf"
    if not conf.is_file():
        print(f"reyos-limine-entries: no {conf}; not a Limine install, nothing to do")
        return 0
    text = conf.read_text()
    lines = text.split("\n")
    section = find_section(lines)
    if section is None:
        print("reyos-limine-entries: no ReyOS entry in limine.conf; leaving it alone")
        return 0
    start, end = section
    body = lines[start:end]
    # The first ReyOS entry is the normal kernel's, never a snapshot's.
    cmdline = next((l.split(":", 1)[1].strip() for l in body if l.strip().startswith("cmdline:")), "")
    if "root=" not in cmdline:
        print("reyos-limine-entries: couldn't read the kernel command line; leaving limine.conf alone", file=sys.stderr)
        return 1
    # Keep the key names the existing file uses (kernel_path vs path).
    kernel_key = "path" if any(re.match(r"\s*path:", l) for l in body) else "kernel_path"
    if not ((esp / "vmlinuz-linux").is_file() and (esp / "initramfs-linux.img").is_file()):
        print("reyos-limine-entries: the normal kernel's files are missing; leaving limine.conf alone", file=sys.stderr)
        return 1
    new_section = build(esp, cmdline, kernel_key)
    new_lines = set_default(lines[:start] + new_section + lines[end:], start)
    new_text = "\n".join(new_lines)
    if not new_text.endswith("\n"):
        new_text += "\n"
    if new_text == text:
        return 0
    backup = conf.with_name("limine.conf.reyos-bak")
    backup.write_text(text)
    tmp = conf.with_name("limine.conf.reyos-new")
    with open(tmp, "w") as f:
        f.write(new_text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, conf)
    titles = [l[1:] for l in new_section if l.startswith("/")]
    print("reyos-limine-entries: boot menu: " + ", ".join(titles))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
