#!/usr/bin/env bash
set -euo pipefail

# /run/archiso/airootfs (the previous check here) no longer exists on
# current archiso builds -- confirmed on a genuine live boot (2026-08-31,
# `ls /run/archiso` returns "No such file or directory"). The kernel
# cmdline's archiso parameters are the actual stable, version-independent
# marker mkarchiso sets for a live boot -- confirmed absent on a real
# installed system's cmdline the same session. Same fix applied to
# reyos-control-center-gui's and reyos-welcome's equivalent checks.
if ! grep -qE "archisobasedir=|archisolabel=" /proc/cmdline; then
    # Autostart also exists on the installed system: stay silent there.
    [ "${1:-}" = "--autostart" ] && exit 0
    kdialog --error "ReyOS Installer is available only from the live session."
    exit 1
fi

[ "${1:-}" = "--autostart" ] && shift
exec sudo -n /usr/bin/calamares "$@"
