<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.reyos.Connect</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>ReyOS Connect</name>
  <summary>Connect your phone to ReyOS</summary>
  <description>
    <p>
      ReyOS Connect is a simple, native device dashboard for KDE Connect on
      ReyOS. Pair your phone, send files and links, see battery status, and
      more — powered by KDE Connect's existing encrypted connection.
    </p>
  </description>
  <launchable type="desktop-id">org.reyos.Connect.desktop</launchable>
  <provides>
    <binary>reyos-connect</binary>
  </provides>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1"/>
</component>
