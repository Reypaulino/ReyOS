<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ReyOS</vendor>
  <action id="org.reyos.connect.tailscale">
    <description>Turn Tailscale on or off for ReyOS Connect</description>
    <message>ReyOS Connect wants to turn Tailscale on or off</message>
    <icon_name>network-vpn</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/reyos/connect/reyos-connect-tailscale</annotate>
  </action>
</policyconfig>
