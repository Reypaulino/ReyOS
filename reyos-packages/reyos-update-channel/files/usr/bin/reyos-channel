#!/usr/bin/env bash
# ReyOS update channels.
#   stable  (default) Arch's repos come from one Arch Linux Archive snapshot,
#           /usr/share/reyos/stable-snapshot. ReyOS moves that date forward in
#           a package update only after the snapshot passed testing, so a
#           half-finished Arch rebuild (Qt 6.12, 2026-10-08) never arrives.
#   rolling Arch's live mirrors from /etc/pacman.d/mirrorlist.
# /etc/pacman.conf points core/extra/multilib at /etc/pacman.d/reyos-mirrorlist,
# which this script writes.
set -euo pipefail

CHANNEL_FILE=/etc/reyos/update-channel
SNAPSHOT_FILE=/usr/share/reyos/stable-snapshot
MIRRORLIST=/etc/pacman.d/reyos-mirrorlist
ARCH_MIRRORLIST=/etc/pacman.d/mirrorlist
PACMAN_CONF=/etc/pacman.conf
SYNC_DIR=/var/lib/pacman/sync
FALLBACK_MIRROR='https://geo.mirror.pkgbuild.com/$repo/os/$arch'
UPDATE_LOG=/var/log/reyos-update.log
PACMAN_LOCK=/var/lib/pacman/db.lck
INHIBIT_WHY="Installing updates. The computer can restart when they're done."

usage() {
    cat <<'EOF'
Usage: reyos-channel [status]
       reyos-channel stable [--yes]    switch to the tested Arch snapshot (default)
       reyos-channel rolling [--yes]   switch to Arch's live mirrors
       reyos-channel upgrade [--yes]   install updates for the current channel
       reyos-channel install [--yes] PKG...
                                       install packages together with the
                                       channel's updates (never a partial upgrade)
       reyos-channel regenerate        rewrite /etc/pacman.d/reyos-mirrorlist
With --yes, the update runs as its own system service (output shown here
and kept in /var/log/reyos-update.log), so closing the terminal or a
desktop restart during the update can't stop it half-way.
EOF
}

channel() {
    if [ "$(cat "$CHANNEL_FILE" 2>/dev/null)" = rolling ]; then echo rolling; else echo stable; fi
}

snapshot() {
    tr -d '[:space:]' < "$SNAPSHOT_FILE"
}

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "reyos-channel: this needs root (try: sudo reyos-channel $*)" >&2
        exit 1
    fi
}

# ---- Updates as their own system service ----------------------------------
# On 2026-10-20 an update that restarted the desktop session (X11 -> Wayland)
# killed Control Center and, with it, the pacman it had started: half-way
# through pacman's hooks, after the old kernels had been removed from /boot
# and before the new ones were copied, so the laptop had nothing to boot.
# Updates now run in a system service (REYOS_CHANNEL_UNIT=1 inside it), not
# in the caller's process tree, with shutdown and sleep held off until done.

protected() { [ -n "${REYOS_CHANNEL_UNIT:-}" ]; }

can_protect() {
    [ -d /run/systemd/system ] && command -v systemd-run >/dev/null && ! systemd-detect-virt -q --chroot
}

run_protected() {  # reyos-channel ARGS in its own service; its output is shown here
    local rc=0 tailer
    : > "$UPDATE_LOG"
    tail -n +1 -F "$UPDATE_LOG" 2>/dev/null &
    tailer=$!
    systemd-run --quiet --wait --collect --unit="reyos-update-$(date +%s)" --description="ReyOS update" \
        --property=StandardOutput=append:"$UPDATE_LOG" --property=StandardError=append:"$UPDATE_LOG" \
        --setenv=REYOS_CHANNEL_UNIT=1 \
        -- systemd-inhibit --what=shutdown:sleep --mode=block --who="ReyOS update" --why="$INHIBIT_WHY" \
        /usr/bin/reyos-channel "$@" || rc=$?
    sleep 1
    kill "$tailer" 2>/dev/null || true
    return "$rc"
}

# A newer stable snapshot while an older, unprotected reyos-channel (or a
# plain pacman) is updating: that caller would make the big jump right after
# this transaction, still in the desktop session. Leave the mirror list
# alone so it stops after this pass, and finish in a service instead.
snapshot_deferred() {
    [ "$(channel)" = stable ] && ! protected && can_protect && [ -f "$MIRRORLIST" ] &&
        ! grep -q "/repos/$(snapshot)/" "$MIRRORLIST"
}

start_finish() {
    systemctl is-active --quiet reyos-update-finish.service && return 0
    echo ":: The update continues from the tested Arch snapshot $(snapshot) as a system service,"
    echo "   so a desktop restart can't stop it. Please don't turn the computer off until it's"
    echo "   done (progress: $UPDATE_LOG)."
    systemd-run --quiet --no-block --collect --unit=reyos-update-finish --description="ReyOS update (finishing)" \
        --property=StandardOutput=append:"$UPDATE_LOG" --property=StandardError=append:"$UPDATE_LOG" \
        --setenv=REYOS_CHANNEL_UNIT=1 \
        -- systemd-inhibit --what=shutdown:sleep --mode=block --who="ReyOS update" --why="$INHIBIT_WHY" \
        /usr/bin/reyos-channel finish || true
}

finish() {  # reyos-update-finish.service: wait for the pacman that started it, then update
    need_root finish
    local free=0 waited=0
    while [ "$free" -lt 5 ] && [ "$waited" -lt 3600 ]; do
        if [ -e "$PACMAN_LOCK" ] || pgrep -x pacman >/dev/null; then free=0; else free=$((free + 1)); fi
        sleep 1
        waited=$((waited + 1))
    done
    echo ":: Finishing the update from the tested Arch snapshot $(snapshot)..."
    upgrade 1
    echo ":: ReyOS update finished."
}

regenerate() {
    need_root regenerate
    # From pacman (package scriptlet, hook): maybe later, see snapshot_deferred.
    if [ "${1:-}" = --deferrable ] && snapshot_deferred; then
        start_finish
        return 0
    fi
    local tmp
    tmp=$(mktemp "$MIRRORLIST.XXXXXX")
    {
        echo "# Written by reyos-channel. Don't edit; switch with: sudo reyos-channel stable|rolling"
        if [ "$(channel)" = stable ]; then
            echo "# Channel: stable (Arch Linux Archive snapshot $(snapshot))"
            echo "Server = https://archive.archlinux.org/repos/$(snapshot)/\$repo/os/\$arch"
        else
            echo "# Channel: rolling (servers from $ARCH_MIRRORLIST)"
            if grep -qE '^[[:space:]]*Server[[:space:]]*=' "$ARCH_MIRRORLIST" 2>/dev/null; then
                grep -E '^[[:space:]]*Server[[:space:]]*=' "$ARCH_MIRRORLIST"
            else
                echo "Server = $FALLBACK_MIRROR"
            fi
        fi
    } > "$tmp"
    chmod 644 "$tmp"
    if cmp -s "$tmp" "$MIRRORLIST"; then
        rm -f "$tmp"
        return
    fi
    mv -f "$tmp" "$MIRRORLIST"
    # A switch can go to an older snapshot whose databases look older than the
    # cached ones, and `pacman -Sy` would keep the cached ones and then ask the
    # new server for files it doesn't have. Make the cache look stale instead.
    for db in "$SYNC_DIR"/*.db; do
        [ -e "$db" ] && touch -d '2000-01-01' "$db"
    done
    return 0
}

migrate_conf() {
    need_root migrate-conf
    [ -f "$PACMAN_CONF" ] || return 0
    sed -i -E "s|^([[:space:]]*#?[[:space:]]*Include[[:space:]]*=[[:space:]]*)/etc/pacman\.d/mirrorlist[[:space:]]*$|\1$MIRRORLIST|" "$PACMAN_CONF"
}

restore_conf() {
    need_root restore-conf
    [ -f "$PACMAN_CONF" ] || return 0
    sed -i -E "s|^([[:space:]]*#?[[:space:]]*Include[[:space:]]*=[[:space:]]*)/etc/pacman\.d/reyos-mirrorlist[[:space:]]*$|\1$ARCH_MIRRORLIST|" "$PACMAN_CONF"
}

# Arch packages installed at a newer version than the snapshot has, as repo/name.
newer_than_snapshot() {
    local repo name ver rest inst
    for repo in core extra multilib; do
        pacman -Sl "$repo" 2>/dev/null | while read -r repo name ver rest; do
            case "$rest" in
                "[installed: "*)
                    inst=${rest#"[installed: "}
                    inst=${inst%"]"}
                    if [ "$(vercmp "$inst" "$ver")" -gt 0 ]; then echo "$repo/$name"; fi ;;
            esac
        done
    done
}

pacman_upgrade() {
    # pacman_upgrade YES [PKG...]: sync, then upgrade everything -- and install
    # PKG... in the same transaction, so a new package never lands on top of
    # older installed libraries (Arch doesn't support partial upgrades).
    local yes=$1 opts=() back=()
    shift
    if [ "$yes" = 1 ]; then opts=(--noconfirm); fi
    if [ $# -gt 0 ]; then opts+=(--needed); fi
    pacman -Sy "${opts[@]}"
    # On stable, Arch packages newer than the snapshot go back to its versions
    # in the same transaction, so the system is the tested set. Not -uu: that
    # would also downgrade reyos-* packages newer than the published ones.
    if [ "$(channel)" = stable ]; then
        mapfile -t back < <(newer_than_snapshot)
        if [ ${#back[@]} -gt 0 ]; then
            echo ":: Moving ${#back[@]} package(s) back to the tested snapshot versions"
        fi
    fi
    pacman -Su "${opts[@]}" "${back[@]}" "$@"
}

switch_to() {
    local target=$1 yes=$2
    need_root "$target"
    mkdir -p "$(dirname "$CHANNEL_FILE")"
    echo "$target" > "$CHANNEL_FILE"
    migrate_conf
    regenerate
    if [ "$target" = stable ]; then
        echo ":: Channel: stable (Arch snapshot $(snapshot))"
    else
        echo ":: Channel: rolling (Arch's live mirrors)"
    fi
    pacman_upgrade "$yes"
}

upgrade() {
    local yes=$1 before after
    need_root upgrade
    # A snapshot an older reyos-channel left for later (snapshot_deferred).
    if protected; then regenerate; fi
    before=$(cat "$MIRRORLIST" 2>/dev/null || true)
    pacman_upgrade "$yes"
    after=$(cat "$MIRRORLIST" 2>/dev/null || true)
    # The update itself may have moved the stable snapshot forward.
    if [ "$before" != "$after" ]; then
        echo ":: The stable snapshot moved forward to $(snapshot); updating from it..."
        pacman_upgrade "$yes"
    fi
}

install_pkgs() {
    local yes=$1 before after p
    shift
    need_root install
    if protected; then regenerate; fi
    [ $# -gt 0 ] || { echo "reyos-channel install: no packages given" >&2; exit 2; }
    for p in "$@"; do
        # NAME or REPO/NAME (reyos-admin asks for reyos-local/... explicitly).
        [[ $p =~ ^([a-z0-9-]+/)?[a-z0-9@_+][a-z0-9@._+-]*$ ]] || { echo "reyos-channel: invalid package name: $p" >&2; exit 2; }
    done
    before=$(cat "$MIRRORLIST" 2>/dev/null || true)
    pacman_upgrade "$yes" "$@"
    after=$(cat "$MIRRORLIST" 2>/dev/null || true)
    if [ "$before" != "$after" ]; then
        echo ":: The stable snapshot moved forward to $(snapshot); updating from it..."
        pacman_upgrade "$yes"
    fi
}

yes=0
if [ "${2:-}" = "--yes" ]; then yes=1; fi

# Unattended updates (--yes: Control Center, Welcome, System Tools) run as a
# system service. Interactive ones stay in the terminal for pacman's prompts.
case "${1:-}" in
    upgrade|install|stable|rolling)
        if [ "$yes" = 1 ] && ! protected && can_protect; then
            need_root "$1"
            rc=0
            run_protected "$@" || rc=$?
            exit "$rc"
        fi ;;
esac

case "${1:-status}" in
    status)
        if [ "$(channel)" = stable ]; then echo "stable $(snapshot)"; else echo rolling; fi ;;
    stable|rolling) switch_to "$1" "$yes" ;;
    upgrade) upgrade "$yes" ;;
    install)
        shift
        if [ "${1:-}" = "--yes" ]; then shift; else yes=0; fi
        install_pkgs "$yes" "$@" ;;
    regenerate) regenerate "${2:-}" ;;
    finish) finish ;;
    migrate-conf) migrate_conf ;;
    restore-conf) restore_conf ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
