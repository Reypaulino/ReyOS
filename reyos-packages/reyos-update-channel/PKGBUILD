# Maintainer: Rey Paulino
pkgname=reyos-update-channel
# pkgver is the Arch Linux Archive snapshot the stable channel uses
# (files/usr/share/reyos/stable-snapshot). Move both forward together, only
# after the snapshot passed .github/workflows/stable-snapshot-check.yml.
pkgver=2026.10.07
pkgrel=1
pkgdesc="ReyOS update channels: stable (tested Arch snapshot, default) or rolling"
arch=('any')
license=('MIT')
depends=('pacman' 'sudo')
install=reyos-update-channel.install
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/files/usr/bin/reyos-channel" "$pkgdir/usr/bin/reyos-channel"
    install -Dm644 "$startdir/files/usr/share/reyos/stable-snapshot" "$pkgdir/usr/share/reyos/stable-snapshot"
    install -Dm644 "$startdir/files/usr/share/libalpm/hooks/reyos-update-channel.hook" "$pkgdir/usr/share/libalpm/hooks/reyos-update-channel.hook"
    install -dm750 "$pkgdir/etc/sudoers.d"
    install -Dm440 "$startdir/files/etc/sudoers.d/reyos-update-channel" "$pkgdir/etc/sudoers.d/reyos-update-channel"
}
