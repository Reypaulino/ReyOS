# Rules now ship in /etc/sudoers.d/90-reyos; drop the wildcard file Calamares used to write (RB-1).
post_install() {
    rm -f /etc/sudoers.d/99-reyos-system-menu
    # Automatic snapshots on a btrfs install whose Timeshift was never set up
    # (does nothing on ext4 or when Timeshift is already configured).
    /usr/share/reyos/bin/reyos-snapshots setup || true
    systemctl enable reyos-snapshots-sync.service >/dev/null 2>&1 || true
    # Files too big for GitHub Pages (NVIDIA's 580 driver) are in a GitHub
    # release; pacman tries the next Server when the first one doesn't have a file.
    grep -q 'releases/download/reyos-drivers' /etc/pacman.conf ||
        sed -i '/^\[reyos-local\]/,/^\[/s|^Server = https://reypaulino\.github\.io/ReyOS/\?$|&\nServer = https://github.com/Reypaulino/ReyOS/releases/download/reyos-drivers|' /etc/pacman.conf
}

post_upgrade() {
    post_install
}
