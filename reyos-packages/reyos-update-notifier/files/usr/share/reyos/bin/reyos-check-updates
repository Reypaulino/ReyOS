#!/usr/bin/env python3
"""Checks the reyos-local package repo (GitHub Pages) for newer versions of
installed reyos-* packages, and Flatpak apps for updates, and sends a
desktop notification if any are found. Fetches the repo database over plain HTTPS instead of `pacman -Sy`
(which needs root) so this can run unprivileged as a per-user systemd timer.
"""
import io
import shutil
import subprocess
import tarfile
import urllib.error
import urllib.request
import time
from pathlib import Path

REPO_DB_URL = "https://reypaulino.github.io/ReyOS/reyos-local.db.tar.gz"


def fetch_repo_versions():
    try:
        with urllib.request.urlopen(REPO_DB_URL, timeout=15) as resp:
            data = resp.read()
    except (urllib.error.URLError, OSError):
        return None
    versions = {}
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
        for member in tar.getmembers():
            if not member.name.endswith("/desc"):
                continue
            extracted = tar.extractfile(member)
            if extracted is None:
                continue
            lines = extracted.read().decode(errors="ignore").splitlines()
            name = version = None
            for i, line in enumerate(lines):
                if line == "%NAME%" and i + 1 < len(lines):
                    name = lines[i + 1]
                elif line == "%VERSION%" and i + 1 < len(lines):
                    version = lines[i + 1]
            if name and version:
                versions[name] = version
    return versions


def installed_version(name):
    result = subprocess.run(["pacman", "-Q", name], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    parts = result.stdout.split()
    return parts[1] if len(parts) > 1 else None


def is_newer(remote_version, local_version):
    result = subprocess.run(["vercmp", remote_version, local_version], capture_output=True, text=True)
    try:
        return int(result.stdout.strip()) > 0
    except ValueError:
        return False


def flatpak_updates():
    """Names of Flatpak apps (Reyva, emulators...) with an update, user and
    system installs. Reads the remotes' summaries; no password needed."""
    names = []
    for scope in ("--user", "--system"):
        try:
            out = subprocess.run(["flatpak", "remote-ls", scope, "--updates", "--app", "--columns=name"],
                                 capture_output=True, text=True, timeout=90).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        names += [line.strip() for line in out.splitlines() if line.strip()]
    return names


def already_told(key):
    """True when this same set of updates was announced in the last day, so
    the 30-minute timer doesn't repeat one notification all day."""
    stamp = Path.home() / ".cache" / "reyos" / "update-notified"
    try:
        if stamp.read_text() == key and time.time() - stamp.stat().st_mtime < 86400:
            return True
    except OSError:
        pass
    try:
        stamp.parent.mkdir(parents=True, exist_ok=True)
        stamp.write_text(key)
    except OSError:
        pass
    return False


def main():
    remote = fetch_repo_versions() or {}

    updates = []
    for name, remote_ver in remote.items():
        local_ver = installed_version(name)
        if local_ver and is_newer(remote_ver, local_ver):
            updates.append(name)
    flatpaks = flatpak_updates() if shutil.which("flatpak") else []

    if not updates and not flatpaks:
        return
    if already_told("\n".join(sorted(updates) + sorted(flatpaks))):
        return

    parts = []
    if updates:
        parts.append("ReyOS apps: " + ", ".join(updates) + ".")
    if flatpaks:
        parts.append("Flatpak apps: " + ", ".join(flatpaks) + ".")
    # Control Center offers all of these in one "Updates are ready" dialog.
    parts.append("Open Control Center to install them in one click.")

    subprocess.Popen([
        "notify-send", "-a", "ReyOS", "-i", "system-software-update",
        "ReyOS updates are ready", " ".join(parts),
    ])


if __name__ == "__main__":
    main()
