# Maintainer: Rey Paulino
# Based on CachyOS's cachyos-calamares-next recipe
# (https://github.com/CachyOS/CachyOS-PKGBUILDS/blob/master/cachyos-calamares/PKGBUILD),
# built by us instead of pulled from the cachyos repo — the repo's own
# cachyos-calamares 3.4.2-4 build was linked against an older boost-libs
# than what cachyos/extra currently ship (libboost_python314.so.1.91.0
# missing, only .so.1.92.0 present), breaking the installer outright.
# Building the same source ourselves against current deps sidesteps that
# repo-timing drift; see docs/bugs.md for the original failure.
pkgname=reyos-calamares-core
pkgver=3.4.2
pkgrel=1
pkgdesc="Calamares installer engine, built by ReyOS against current deps (CachyOS's cachyos-dev branch)"
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/CachyOS/cachyos-calamares"
conflicts=('calamares' 'cachyos-calamares' 'cachyos-calamares-next')
provides=('calamares')
depends=(
  boost-libs
  cryptsetup
  dmidecode
  gptfdisk
  hwinfo
  kconfig
  kcoreaddons
  kcrash
  ki18n
  kparts
  kpmcore
  kservice
  kwidgetsaddons
  libpwquality
  networkmanager
  polkit-qt6
  python
  qt6-declarative
  qt6-svg
  rsync
  solid
  squashfs-tools
  upower
  yaml-cpp
  qt6-imageformats
  python-toml
)
makedepends=(
  boost
  cmake
  doxygen
  extra-cmake-modules
  git
  ninja
  python-jsonschema
  python-pyaml
  python-unidecode
  qt6-tools
)
sha256sums=('SKIP')
source=(calamares::"git+https://github.com/CachyOS/cachyos-calamares.git#branch=cachyos-dev")
options=('!emptydirs')

prepare() {
    cd "${srcdir}/calamares"
    sed -i -e "s|\${CALAMARES_VERSION_MAJOR}.\${CALAMARES_VERSION_MINOR}.\${CALAMARES_VERSION_PATCH}|${pkgver}-${pkgrel}|g" CMakeLists.txt
    sed -i -e "s|CALAMARES_VERSION_RC 1|CALAMARES_VERSION_RC 0|g" CMakeLists.txt
}

build() {
    cd "${srcdir}/calamares"

    export CXXFLAGS+=" -fPIC"

    cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_APPSTREAM=OFF \
        -DWITH_PYBIND11=OFF \
        -DWITH_QT6=ON \
        -DSKIP_MODULES="dracut dracutlukscfg \
        dummycpp dummyprocess dummypython dummypythonqt \
        finishedq keyboardq license localeq notesqml oemid \
        openrcdmcryptcfg packagechooserq fsresizer \
        rawfs mkinitfs contextualprocess interactiveterminal \
        plasmalnf services-openrc \
        summaryq tracking usersq webview welcomeq"

    cmake --build build
}

package() {
    cd "${srcdir}/calamares/build"
    DESTDIR="${pkgdir}" cmake --build . --target install

    cp "${srcdir}/calamares/settings_offline.conf" "$pkgdir/usr/share/calamares/settings_offline.conf"
    cp "${srcdir}/calamares/settings_online.conf" "$pkgdir/usr/share/calamares/settings_online.conf"
    cp "${srcdir}/calamares/settings_online.conf" "$pkgdir/usr/share/calamares/settings.conf"
    local _destdir=etc/calamares
    install -dm755 "$pkgdir/$_destdir"
    install -dm755 "$pkgdir/$_destdir/modules"
    cp -rf "${srcdir}"/calamares/src/modules/*/*.conf "$pkgdir/etc/calamares/modules"
    cp -rf "${srcdir}/calamares/src/scripts" "$pkgdir/etc/calamares"
    cp -rf "${srcdir}/calamares/src/images" "$pkgdir/etc/calamares"

    cp "${srcdir}/calamares/src/modules/netinstall/netinstall.yaml" "$pkgdir/etc/calamares/modules/netinstall.yaml"

    rm -rf "$pkgdir/usr/share/applications"
}
