# Maintainer: Rey Paulino
pkgname=reyos-plymouth
pkgver=1.0.0
pkgrel=11
pkgdesc="ReyOS boot splash — Plymouth theme (navy background, centered logo)"
arch=('any')
license=('MIT')
depends=('plymouth')
source=()
sha256sums=()

package() {
    install -Dm644 "$startdir/files/usr/share/plymouth/themes/reyos/reyos.plymouth" \
        "$pkgdir/usr/share/plymouth/themes/reyos/reyos.plymouth"
    install -Dm644 "$startdir/files/usr/share/plymouth/themes/reyos/reyos.script" \
        "$pkgdir/usr/share/plymouth/themes/reyos/reyos.script"
    install -Dm644 "$startdir/files/usr/share/plymouth/themes/reyos/logo.png" \
        "$pkgdir/usr/share/plymouth/themes/reyos/logo.png"
}
