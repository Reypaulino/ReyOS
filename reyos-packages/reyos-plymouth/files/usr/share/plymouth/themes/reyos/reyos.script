# ReyOS Plymouth boot splash (script module).
#
# Deliberately minimal: no loops, arrays, or password/message UI -- this
# runs inside the initramfs on every boot, and this repo's mkinitcpio/boot
# chain has broken in real, hard-to-diagnose ways before (see fixes.md).
# A plain static-logo-on-navy script is the lowest-risk way to get real
# ReyOS branding on the boot splash; a nicer animation can follow once
# this baseline is confirmed safe on a real install.

Window.SetBackgroundTopColor(0.055, 0.055, 0.071);
Window.SetBackgroundBottomColor(0.055, 0.055, 0.071);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

progress = 0;

fun refresh_callback() {
    progress++;
    logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(progress / 20));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
