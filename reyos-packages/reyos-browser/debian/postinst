#!/bin/sh
# Builds the app's Python venv fresh at install time from requirements.txt
# instead of shipping a pre-built one. See debian/control for why: a prior
# hand-built venv ended up with an incomplete PySide6 install and the app
# silently failed to launch with no visible error.
set -e

APP_DIR=/opt/reyos-browser
VENV_DIR="$APP_DIR/.venv"

if ! command -v python3 >/dev/null 2>&1; then
    echo "reyos-browser: python3 not found, cannot build the app's runtime environment" >&2
    exit 1
fi

rm -rf "$VENV_DIR"
python3 -m venv "$VENV_DIR"
"$VENV_DIR/bin/python3" -m pip install --no-cache-dir --upgrade pip
"$VENV_DIR/bin/python3" -m pip install --no-cache-dir -r "$APP_DIR/requirements.txt"

chmod -R a+rX "$APP_DIR"

exit 0
