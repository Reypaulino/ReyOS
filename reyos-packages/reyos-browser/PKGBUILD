# Maintainer: Rey Paulino
pkgname=reyos-browser
pkgver=0.1.0
pkgrel=106
pkgdesc="Reyva — the private-by-default web browser from ReyOS (runs the com.reyapps.Reyva Flatpak)"
arch=('any')
license=('MPL-2.0')
# Since 106 the Arch package no longer runs the browser on the system Qt: an
# Arch Qt 6.12 rollout (2026-10-08) shipped a pyside6 needing qt6-webengine
# 6.12 symbols that weren't released yet, so it crashed on launch. Reyva now
# runs as the Flatpak (its own Qt); files/ still holds the browser source the
# Flatpak, .deb and Windows builds use.
depends=('flatpak' 'kdialog' 'qt6-tools')
install=reyos-browser.install
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/arch-flatpak/usr/bin/reyos-browser" "$pkgdir/usr/bin/reyos-browser"
    install -Dm644 "$startdir/files/usr/share/applications/reyos-browser.desktop" "$pkgdir/usr/share/applications/reyos-browser.desktop"
    install -Dm644 "$startdir/files/usr/share/icons/hicolor/scalable/apps/reyos-browser.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/reyos-browser.svg"
}
