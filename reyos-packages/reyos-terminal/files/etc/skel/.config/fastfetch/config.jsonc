{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/reyos-ascii.txt",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "38;2;201;121;50",
            "title": "38;2;201;121;50"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "terminal",
        "cpu",
        "gpu",
        {
            "type": "memory",
            "format": "{used} / {total} ({percentage})"
        }
    ]
}
