# Maintainer: Rey Paulino
pkgname=reyos-preload
pkgver=1.0.0
pkgrel=1
pkgdesc="ReyOS adaptive preload daemon — learns per-app file access patterns and prefetches them into the page cache on launch"
arch=('any')
license=('MIT')
depends=('python' 'systemd')
source=()
sha256sums=()

package() {
    cp -a "$startdir/files/usr" "$pkgdir/"
    chmod 755 "$pkgdir/usr/share/reyos/bin/reyos-preloadd"
    chmod 644 "$pkgdir/usr/lib/systemd/system/reyos-preloadd.service"
}
